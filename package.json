{
  "name": "@berrydev-ai/wave-api-client",
  "version": "1.0.1",
  "description": "TypeScript client for Wave API (African fintech platform)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun test && bun run lint",
    "docs": "typedoc --out docs src",
    "clean": "rm -rf dist coverage",
    "publish:patch": "npm version patch && git push --follow-tags && npm publish",
    "publish:minor": "npm version minor && git push --follow-tags && npm publish",
    "publish:major": "npm version major && git push --follow-tags && npm publish"
  },
  "keywords": [
    "wave",
    "api",
    "client",
    "fintech",
    "payment",
    "africa",
    "sdk"
  ],
  "author": "Florent Azonnoudo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berrydev-ai/wave-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/berrydev-ai/wave-api-client/issues"
  },
  "homepage": "https://github.com/berrydev-ai/wave-api-client",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.7",
    "typedoc": "^0.24.1",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
